  "scenes": [
    {
      "say": "Why does your blush disappear by noon? It's usually how you layer it, not the blush itself.",
      "query": [
        "blush makeup",
        "makeup brush cheek",
        "applying blush"
      ],
      "clips": [
        "pb72007",
        "pb12004",
        "pb270065"
      ]
    },
    {
      "say": "First, let your sunscreen and base sit for two minutes. Blush slides around on damp skin.",
      "label": "Step 1",
      "query": [
        "applying sunscreen face",
        "foundation makeup",
        "skincare face"
      ],
      "clips": [
        "cvOrVUhC5L0A",
        "pb210574"
      ],
      "check": "Let your base set 2 min"
    },
    {
      "say": "Next, tap a cream or liquid blush onto your cheeks with your fingertip. Tap, don't swipe.",
      "label": "Step 2",
      "query": [
        "cream blush",
        "makeup fingers cheek",
        "applying makeup cheek"
      ],
      "clips": [
        "pb38080",
        "pb203732"
      ],
      "check": "Tap on cream blush"
    },
    {
      "say": "Then dust a little powder blush in the same shade on top. Two thin layers stay put longer.",
      "label": "Step 3",
      "query": [
        "powder blush brush",
        "makeup brush",
        "blush palette"
      ],
      "clips": [
        "pb25850",
        "cvhZXup8fQX0"
      ],
      "check": "Same-shade powder on top"
    },
    {
      "say": "The common mistake? One heavy layer of powder. It sits on top and wears off unevenly.",
      "label": "Common mistake",
      "query": [
        "makeup mirror",
        "face makeup",
        "makeup brush"
      ],
      "clips": [
        "cvsAibMdAOQE",
        "cvXQoTqbEf8P"
      ]
